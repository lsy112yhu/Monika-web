# Copy to the server only. Do not commit a filled .env.
MUSIC_API_HOST=127.0.0.1
MUSIC_API_PORT=8767
MUSIC_DATA_FILE=/var/lib/monika-web/music-state.json
MUSIC_ADMIN_USERNAME=admin
# PBKDF2 hash, format: pbkdf2_sha256$iterations$salt$hash
MUSIC_ADMIN_PASSWORD_HASH=
MUSIC_SESSION_SECRET=
MUSIC_SESSION_TTL_SECONDS=43200
# Key used to encrypt the upstream music login state at rest.
MUSIC_CREDENTIALS_KEY=
MUSIC_AUDIO_QUALITY=320
MUSIC_PUBLIC_STREAM_LIMIT=12
MUSIC_PER_IP_STREAM_LIMIT=3
