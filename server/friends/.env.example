# Copy to the server only. Do not commit a filled .env.
FRIENDS_API_HOST=127.0.0.1
FRIENDS_API_PORT=8766
FRIENDS_DATA_FILE=/var/lib/monika-web/friends.json
FRIENDS_ADMIN_USERNAME=admin
# PBKDF2 hash, format: pbkdf2_sha256$iterations$salt$hash
FRIENDS_ADMIN_PASSWORD_HASH=
FRIENDS_SESSION_SECRET=
FRIENDS_SESSION_TTL_SECONDS=43200
